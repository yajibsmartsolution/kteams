# Railway runtime
NODE_ENV=production
KEDCO_PUBLIC_URL=https://teams.com.ng
CORS_ORIGIN=https://teams.com.ng,https://www.teams.com.ng
# Railway injects PORT at runtime; leave it unset in the service variables.

# Set this to the absolute mount path of the Railway Volume.
# Create and attach a Volume at /data, then use /data/kedco here.
KEDCO_LOCAL_DATA_ROOT=/data/kedco

# Optional password reset email delivery
KEDCO_SMTP_HOST=smtp.example.com
KEDCO_SMTP_PORT=587
KEDCO_SMTP_SECURE=false
KEDCO_SMTP_USER=
KEDCO_SMTP_PASS=
KEDCO_SMTP_FROM=KEDCO Technical Automation <no-reply@example.com>
